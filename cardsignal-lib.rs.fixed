use base64::Engine;
use chrono::{DateTime, Datelike, Months, NaiveDate, Utc};
use parking_lot::Mutex;
use regex::Regex;
use reqwest::header::{ACCEPT, ACCEPT_LANGUAGE, AUTHORIZATION};
use rusqlite::{params, Connection, OptionalExtension};
use scraper::{Html, Selector};
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};
use std::{
    collections::{HashMap, HashSet},
    fs,
    path::{Path, PathBuf},
    process::Command,
    time::Duration,
};
use tauri::{AppHandle, Manager, State};
use thiserror::Error;
use url::Url;

const APP_VERSION: &str = "0.5.0";
const KEYRING_SERVICE: &str = "CardSignal";
const DATABASE_NAME: &str = "cardsignal.db";
const STORES: &[&str] = &[
    "cards",
    "slabs",
    "reports",
    "snapshots",
    "meta",
    "auctionProfiles",
    "auctions",
];

#[derive(Debug, Error)]
enum CardSignalError {
    #[error("{0}")]
    Message(String),
    #[error(transparent)]
    Sqlite(#[from] rusqlite::Error),
    #[error(transparent)]
    Io(#[from] std::io::Error),
    #[error(transparent)]
    Http(#[from] reqwest::Error),
    #[error(transparent)]
    Json(#[from] serde_json::Error),
    #[error(transparent)]
    Csv(#[from] csv::Error),
    #[error(transparent)]
    Url(#[from] url::ParseError),
}

type CsResult<T> = Result<T, CardSignalError>;

impl From<CardSignalError> for String {
    fn from(value: CardSignalError) -> Self {
        value.to_string()
    }
}

#[derive(Clone)]
struct CachedEbayToken {
    token: String,
    expires_at: DateTime<Utc>,
}

struct AppState {
    data_dir: PathBuf,
    database_path: PathBuf,
    backup_dir: PathBuf,
    http: reqwest::Client,
    ebay_token: Mutex<Option<CachedEbayToken>>,
    started_at: DateTime<Utc>,
}

#[derive(Debug, Serialize)]
#[serde(rename_all = "camelCase")]
struct HealthInfo {
    ok: bool,
    version: String,
    mode: String,
    database_path: String,
    database_size_bytes: u64,
    data_directory: String,
    backup_directory: String,
    backup_count: usize,
    last_backup: Option<String>,
    record_counts: HashMap<String, usize>,
    psa_configured: bool,
    ebay_configured: bool,
    uptime_seconds: i64,
}

#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
struct EbayCredentialsInput {
    client_id: String,
    client_secret: String,
}

fn message<T: Into<String>>(text: T) -> CardSignalError {
    CardSignalError::Message(text.into())
}

fn open_connection(path: &Path) -> CsResult<Connection> {
    let connection = Connection::open(path)?;
    connection.pragma_update(None, "journal_mode", "WAL")?;
    connection.pragma_update(None, "foreign_keys", "ON")?;
    connection.busy_timeout(Duration::from_secs(10))?;
    Ok(connection)
}

fn initialize_database(path: &Path) -> CsResult<()> {
    let connection = open_connection(path)?;
    connection.execute_batch(
        "
        CREATE TABLE IF NOT EXISTS records (
            store TEXT NOT NULL,
            id TEXT NOT NULL,
            json TEXT NOT NULL,
            updated_at TEXT NOT NULL,
            PRIMARY KEY (store, id)
        );
        CREATE INDEX IF NOT EXISTS idx_records_store ON records(store);
        CREATE TABLE IF NOT EXISTS app_info (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );
        INSERT INTO app_info(key, value) VALUES('schema_version', '1')
            ON CONFLICT(key) DO UPDATE SET value=excluded.value;
        ",
    )?;
    Ok(())
}

fn validate_store(store: &str) -> CsResult<()> {
    if STORES.contains(&store) {
        Ok(())
    } else {
        Err(message(format!("Unknown CardSignal data store: {store}")))
    }
}

fn extract_id(value: &Value) -> CsResult<String> {
    value
        .get("id")
        .and_then(Value::as_str)
        .map(str::to_owned)
        .filter(|id| !id.trim().is_empty())
        .ok_or_else(|| message("Record is missing a non-empty id field."))
}

fn keyring_entry(name: &str) -> CsResult<keyring::Entry> {
    keyring::Entry::new(KEYRING_SERVICE, name)
        .map_err(|error| message(format!("Windows Credential Manager is unavailable: {error}")))
}

fn get_secret(name: &str) -> CsResult<Option<String>> {
    let entry = keyring_entry(name)?;
    match entry.get_password() {
        Ok(value) => Ok(Some(value)),
        Err(keyring::Error::NoEntry) => Ok(None),
        Err(error) => Err(message(format!("Could not read encrypted credential: {error}"))),
    }
}

fn set_secret(name: &str, value: &str) -> CsResult<()> {
    let entry = keyring_entry(name)?;
    if value.trim().is_empty() {
        match entry.delete_credential() {
            Ok(_) | Err(keyring::Error::NoEntry) => Ok(()),
            Err(error) => Err(message(format!("Could not remove encrypted credential: {error}"))),
        }
    } else {
        entry
            .set_password(value.trim())
            .map_err(|error| message(format!("Could not save encrypted credential: {error}")))
    }
}

fn list_backups(path: &Path) -> CsResult<Vec<PathBuf>> {
    if !path.exists() {
        return Ok(Vec::new());
    }
    let mut files = fs::read_dir(path)?
        .filter_map(Result::ok)
        .map(|entry| entry.path())
        .filter(|entry| {
            entry
                .file_name()
                .and_then(|name| name.to_str())
                .is_some_and(|name| name.starts_with("cardsignal-") && name.ends_with(".db"))
        })
        .collect::<Vec<_>>();
    files.sort_by_key(|entry| fs::metadata(entry).and_then(|meta| meta.modified()).ok());
    files.reverse();
    Ok(files)
}

fn backup_filename() -> String {
    format!("cardsignal-{}.db", Utc::now().format("%Y%m%d-%H%M%S"))
}

fn create_database_backup(database_path: &Path, backup_dir: &Path) -> CsResult<PathBuf> {
    fs::create_dir_all(backup_dir)?;
    let destination = backup_dir.join(backup_filename());
    let source = open_connection(database_path)?;
    let mut target = Connection::open(&destination)?;
    {
        let backup = rusqlite::backup::Backup::new(&source, &mut target)?;
        backup.run_to_completion(16, Duration::from_millis(20), None)?;
    }
    rotate_backups(backup_dir)?;
    Ok(destination)
}

fn rotate_backups(backup_dir: &Path) -> CsResult<()> {
    let files = list_backups(backup_dir)?;
    if files.len() <= 20 {
        return Ok(());
    }

    let now = Utc::now();
    let mut keep = HashSet::<PathBuf>::new();
    let mut seen_days = HashSet::<String>::new();
    let mut seen_weeks = HashSet::<String>::new();
    let mut seen_months = HashSet::<String>::new();

    for (index, file) in files.iter().enumerate() {
        if index < 5 {
            keep.insert(file.clone());
            continue;
        }
        let Some(name) = file.file_stem().and_then(|name| name.to_str()) else {
            continue;
        };
        let stamp = name.trim_start_matches("cardsignal-");
        let Ok(date) = chrono::NaiveDateTime::parse_from_str(stamp, "%Y%m%d-%H%M%S") else {
            continue;
        };
        let date_utc = DateTime::<Utc>::from_naive_utc_and_offset(date, Utc);
        let age_days = (now - date_utc).num_days();
        let day_key = date_utc.format("%Y-%m-%d").to_string();
        let iso = date_utc.iso_week();
        let week_key = format!("{}-{:02}", iso.year(), iso.week());
        let month_key = date_utc.format("%Y-%m").to_string();

        if age_days <= 7 && seen_days.insert(day_key) {
            keep.insert(file.clone());
        } else if age_days <= 35 && seen_weeks.insert(week_key) {
